;;; portal-launcher-prototype.el --- THROWAWAY native launcher -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
;; Start with ./launcher-prototype.sh; never load into your working Emacs.
(require 'json)
(require 'server)
(defconst portal-prototype-directory (file-name-directory (or load-file-name buffer-file-name)))
(defvar portal-prototype-frame nil)
(defvar portal-prototype-return-frame nil)
(defvar portal-prototype-size '(720 420))
(defvar portal-prototype-offset '(0 0))
(defvar portal-prototype-screen -1)
(defvar portal-prototype-open nil)
(defvar portal-prototype-log nil)
(defvar portal-prototype-pending "")

(defun portal-prototype-record (event)
  (let ((entry (list :event event :time (float-time)
                     :native (json-parse-string (portal-prototype--state))
                     :selected-launcher (eq (selected-frame) portal-prototype-frame)
                     :pixels (and (frame-live-p portal-prototype-frame)
                                  (list (frame-pixel-width portal-prototype-frame)
                                        (frame-pixel-height portal-prototype-frame))))))
    (push entry portal-prototype-log)
    (with-temp-file (expand-file-name "build/launcher-prototype-state.el" portal-prototype-directory)
      (pp (reverse portal-prototype-log) (current-buffer)))))

(defun portal-prototype-show ()
  (interactive)
  (unless portal-prototype-open
    (setq portal-prototype-return-frame (selected-frame)))
  ;; Select the Lisp frame without activating Emacs.app. NSPanel owns native focus.
  (select-frame portal-prototype-frame 'norecord)
  (setq portal-prototype-open t)
  (apply #'portal-prototype--show
         (append portal-prototype-size portal-prototype-offset (list portal-prototype-screen)))
  ;; AppKit visibility alone does not enable Emacs redisplay for a hidden frame.
  (make-frame-visible portal-prototype-frame)
  (redisplay t)
  (portal-prototype-record 'show))

(defun portal-prototype-hide ()
  (interactive)
  (portal-prototype--hide)
  (make-frame-invisible portal-prototype-frame)
  (setq portal-prototype-open nil)
  (portal-prototype-record 'hide)
  ;; Abort before selecting another frame: selecting first moves the live prompt
  ;; into that frame, reproducing the m-x cross-monitor minibuffer problem.
  (when (and (active-minibuffer-window)
             (eq (window-frame (active-minibuffer-window)) portal-prototype-frame))
    (abort-recursive-edit))
  (when (frame-live-p portal-prototype-return-frame)
    (select-frame portal-prototype-return-frame 'norecord)))

(defun portal-prototype-event (event)
  (interactive "e")
  (pcase (cadr event)
    ("hotkey" (if portal-prototype-open (portal-prototype-hide) (portal-prototype-show)))
    ("blur" (portal-prototype-hide)
     (portal-prototype-record 'blur))))
(define-key global-map [portal-prototype-event] #'portal-prototype-event)

(defun portal-prototype-filter (_process text)
  (setq portal-prototype-pending (concat portal-prototype-pending text))
  (while (string-match "\n" portal-prototype-pending)
    (let ((line (substring portal-prototype-pending 0 (match-beginning 0))))
      (setq portal-prototype-pending (substring portal-prototype-pending (match-end 0)))
      (setq unread-command-events
            (nconc unread-command-events (list (list 'portal-prototype-event line)))))))

(defun portal-prototype-resize (width height)
  (setq portal-prototype-size (list width height))
  (portal-prototype-show))
(defun portal-prototype-next-screen ()
  (interactive)
  (setq portal-prototype-screen
        (mod (1+ portal-prototype-screen) (length (display-monitor-attributes-list))))
  (portal-prototype-show))
(defun portal-prototype-prompt ()
  (interactive)
  (unwind-protect
      (let ((answer (read-string "Real Emacs minibuffer: ")))
        (portal-prototype-record (list 'prompt answer))
        (message "You typed: %s" answer))
    (when (and (not portal-prototype-open) (frame-live-p portal-prototype-return-frame))
      (select-frame portal-prototype-return-frame 'norecord))))

(defvar portal-prototype-mode-map
  (let ((map (make-sparse-keymap)))
    (define-key map [escape] #'portal-prototype-hide)
    (define-key map (kbd "q") #'portal-prototype-hide)
    (define-key map (kbd "C-g") #'portal-prototype-hide)
    (define-key map (kbd "p") #'portal-prototype-prompt)
    (define-key map (kbd "RET") #'portal-prototype-prompt)
    (define-key map (kbd "TAB") #'portal-prototype-next-screen)
    (define-key map (kbd "1") (lambda () (interactive) (portal-prototype-resize 640 320)))
    (define-key map (kbd "2") (lambda () (interactive) (portal-prototype-resize 720 420)))
    (define-key map (kbd "3") (lambda () (interactive) (portal-prototype-resize 860 520)))
    map))
(define-derived-mode portal-prototype-mode special-mode "Launcher prototype"
  (setq-local mode-line-format nil cursor-type nil truncate-lines t))

(defun portal-prototype-buffer ()
  (with-current-buffer (get-buffer-create "*Portal launcher prototype*")
    (portal-prototype-mode)
    (let ((inhibit-read-only t))
      (erase-buffer)
      (insert (propertize "Search anything…\n" 'face '(:height 1.5 :foreground "#dce1ed")))
      (insert (propertize "A real Emacs buffer, in a native launcher window\n\n" 'face '(:foreground "#8892a8")))
      (insert (propertize "  ›  Hello, world\n" 'face '(:height 1.2 :weight bold :foreground "#b4c9ff")))
      (insert (propertize "     Press Return to use the real minibuffer\n\n" 'face '(:foreground "#98a2b7")))
      (insert "  ◇  Open a project\n\n  +  Capture a thought\n\n")
      (insert (propertize "EXPERIMENT  •  Control–Option–Command–P\n" 'face '(:height 0.85 :foreground "#8892a8")))
      (insert (propertize "1 / 2 / 3  Size     Tab  Screen     Esc  Dismiss" 'face '(:height 0.85 :foreground "#8892a8")))
      (goto-char (point-min)))
    (current-buffer)))

(defun portal-prototype-stop ()
  (interactive)
  (when (fboundp 'portal-prototype--stop) (portal-prototype--stop))
  (setq portal-prototype-open nil)
  (when (frame-live-p portal-prototype-frame) (delete-frame portal-prototype-frame))
  (setq portal-prototype-frame nil))

(defun portal-prototype-start ()
  (setq frame-resize-pixelwise t inhibit-startup-screen t)
  (setq server-name "portal-launcher-prototype")
  (when (server-running-p server-name)
    (error "Launcher prototype is already running; quit that test Emacs first"))
  (server-start)
  (module-load (expand-file-name "build/launcher-prototype.dylib" portal-prototype-directory))
  (let ((controller (selected-frame))
        (pipe (make-pipe-process :name "launcher-prototype" :noquery t
                                  :coding 'utf-8-unix :filter #'portal-prototype-filter)))
    (setq portal-prototype-frame
          (make-frame '((name . "portal-prototype-donor") (title . "portal-prototype-donor")
                        (visibility . nil) (minibuffer . t) (undecorated . t)
                        (width . 80) (height . 20) (font . "Menlo 15")
                        (background-color . "#171a21") (foreground-color . "#e1e5ef")
                        (internal-border-width . 24) (left-fringe . 0) (right-fringe . 0)
                        (menu-bar-lines . 0) (tool-bar-lines . 0) (tab-bar-lines . 0)
                        (vertical-scroll-bars . nil) (horizontal-scroll-bars . nil)
                        (no-focus-on-map . t) (no-other-frame . t) (unsplittable . t))))
    (set-window-buffer (frame-root-window portal-prototype-frame) (portal-prototype-buffer))
    (portal-prototype--install "portal-prototype-donor" pipe
                               (not (equal (getenv "PORTAL_PROTOTYPE_WINDOW") "emacs")))
    (select-frame controller 'norecord))
  (add-hook 'kill-emacs-hook #'portal-prototype-stop)
  (set-frame-parameter nil 'title "Portal launcher experiment — controller")
  (switch-to-buffer (get-buffer-create "*Launcher experiment controls*"))
  (insert "Portal launcher experiment is ready.\n\nControl–Option–Command–P summons the launcher from any app.\n\nThe default host is a real nonactivating NSPanel.\nThe content is the original EmacsView, with a real minibuffer.\n\nInside: Return = prompt; 1/2/3 = sizes; Tab = monitor; Escape = hide.\n\nM-x portal-prototype-stop unregisters the shortcut and restores the view.\nQuit this isolated Emacs when done. Your working Emacs is untouched.\n")
  (portal-prototype-record 'ready))

(provide 'portal-launcher-prototype)
