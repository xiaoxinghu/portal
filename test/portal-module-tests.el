;;; portal-module-tests.el --- The C module bindings with a fake backend -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later

;; Loads the real Emacs bindings, native/Core/emacs.c, and the real core,
;; linked with test/portal-fake-backend.c instead of the macOS backend.  The
;; module file is named by PORTAL_TEST_MODULE; run with --module-assertions.
;; `portal--inspect' reports the core's state of a view and what the fake
;; received.
;; test/portal-views-tests.c covers the core's registry in detail.

(require 'ert)

(let ((file (getenv "PORTAL_TEST_MODULE")))
  (unless (and file (file-exists-p file))
    (error "Set PORTAL_TEST_MODULE to the fake-backend module"))
  (module-load file))

(defconst portal-module-tests--exports
  '((portal--open 2 . 2) (portal--place 3 . 3) (portal--hide 1 . 1) (portal--close 1 . 1)
    (portal--inspect 1 . 1) (portal--channel 1 . 1)
    (portal--web-load 2 . 2) (portal--web-send 2 . 2) (portal--web-receive 1 . 1)
    (portal--web-appearance 1 . 1) (portal--web-go 2 . 2)
    (portal--terminal-paste 2 . 3) (portal--terminal-text 1 . 1)
    (portal--terminal-theme 1 . 1) (portal--terminal-themes 0 . 0)
    (portal--terminal-bindings 1 . 1)
    (portal--input 2 . 3) (portal--input-escape-key 2 . 2))
  "The module exports and their arities.")

(ert-deftest portal-module-escape-key-binding ()
  (unwind-protect
      (progn
        (should (portal--input-escape-key "g" 10))
        (should (portal--input-escape-key "\e" 2))
        (dolist (args '(("" 8) ("ab" 8) ("a" 0) ("a" 1) ("a" -1)
                        ("a" 16) ("a" 4294967296) ("é" 8) (nil 8) ("a" nil)))
          (should-error (apply #'portal--input-escape-key args))))
    (portal--input-escape-key "." 8)))

(ert-deftest portal-module-launcher-bindings ()
  (dolist (entry '((portal--launcher-attach 1 . 1) (portal--launcher-show 7 . 7)
                   (portal--launcher-fit 2 . 2)
                   (portal--launcher-hide 0 . 1) (portal--launcher-detach 0 . 0)
                   (portal--launcher-inspect 0 . 0) (portal--launcher-prepare 0 . 0)))
    (should (equal (func-arity (car entry)) (cdr entry))))
  (portal--launcher-detach)
  (let ((emacs-version "31.1")
        (emacs-repository-version "a360712c9d272d950d8d8255ef74570f7e90b7d9"))
    (unwind-protect
        (progn
          (let ((before (plist-get (portal--launcher-inspect) :calls)))
            (let ((emacs-version "32.1")) (should-error (portal--launcher-attach "new")))
            (let ((emacs-repository-version nil)) (should-error (portal--launcher-attach "new")))
            (dolist (value (list nil 3 [1] (string #xd800) (string-to-unibyte "\377")))
              (should-error (portal--launcher-attach value)))
            (should (= before (plist-get (portal--launcher-inspect) :calls))))
          (should-error (portal--launcher-attach "missing"))
          (should (portal--launcher-attach "frame Ω"))
          (should-error (portal--launcher-attach "another"))
          (should (equal (plist-get (portal--launcher-inspect) :title) "frame Ω"))
          (portal--launcher-show 713 407 -137 81 -1 t 14)
          (let ((state (portal--launcher-inspect)))
            (should (equal (mapcar (lambda (key) (plist-get state key))
                                  '(:width :height :dx :dy :screen :shadow :radius))
                           '(713 407 -137 81 -1 1 14)))
            (dolist (args '((199 407 0 0 -1 t 14) (713 0 0 0 -1 t 14) (713 -60 0 0 -1 t 14)
                            (713 407 0 0 -2 t 14) (713 407 0 0 -1 t -1)
                            (713 407 "0" 0 -1 t 14) (713 407 0 0 -1 t 1.5)))
              (should-error (apply #'portal--launcher-show args)))
            (should (equal state (portal--launcher-inspect))))
          ;; Lisp chooses legal heights below 100 points; they cross as given.
          (portal--launcher-show 713 60 0 0 -1 t 14)
          (should (= 60 (plist-get (portal--launcher-inspect) :height)))
          ;; Fitting crosses as the presented session and a height; the
          ;; platform ignores another session, as the fake does.
          (let ((session (plist-get (portal--launcher-inspect) :session)))
            (should (portal--launcher-fit session 44))
            (should (= 44 (plist-get (portal--launcher-inspect) :height)))
            (should (portal--launcher-fit session 164))
            (should (= 164 (plist-get (portal--launcher-inspect) :height)))
            (should (portal--launcher-fit (1+ session) 300))
            (should (= 164 (plist-get (portal--launcher-inspect) :height)))
            (let ((state (portal--launcher-inspect)))
              (dolist (args `((-1 164) (,session 0) (,session -1) ("1" 164) (,session 164.5) (,session nil)))
                (should-error (apply #'portal--launcher-fit args)))
              (should (equal (plist-get state :height) (plist-get (portal--launcher-inspect) :height))))
            (should (= session (plist-get (portal--launcher-inspect) :session))))
          (portal--launcher-hide)
          (portal--launcher-hide t)
          (should (portal--launcher-fit (plist-get (portal--launcher-inspect) :session) 300))
          (should (= 164 (plist-get (portal--launcher-inspect) :height)))
          (should (= 0 (plist-get (portal--launcher-inspect) :visible)))
          (should (= 1 (plist-get (portal--launcher-inspect) :attached))))
      (portal--launcher-detach)
      (portal--launcher-detach))
    (should (= 0 (plist-get (portal--launcher-inspect) :attached)))
    (should-error (portal--launcher-show 720 420 0 0 -1 t 14))))

(ert-deftest portal-module-shortcut-bindings ()
  ;; test/portal-shortcuts-tests.c covers the core's rules in detail.
  (dolist (entry '((portal--shortcut-chord 1 . 1) (portal--shortcut-set 2 . 2)
                   (portal--shortcut-remove 1 . 1) (portal--shortcuts 0 . 0)))
    (should (equal (func-arity (car entry)) (cdr entry)))
    (should (stringp (documentation (car entry)))))
  (should-not (portal--shortcuts))
  (should (equal (portal--shortcut-chord "command-shift-control-p") "Control-Shift-Command-P"))
  (should (equal (should-error (portal--shortcut-chord "Hyper-P"))
                 '(error "A shortcut's modifiers are Control, Option, Command and Shift, each at most once, not: Hyper")))
  (dolist (value (list nil 3 [1] (string #xd800) (string-to-unibyte "\377")))
    (should-error (portal--shortcut-chord value))
    (should-error (portal--shortcut-set nil value)))
  (let ((id (portal--shortcut-set nil "Control-Option-Command-M")))
    (should (natnump id))
    (should (equal (portal--shortcuts)
                   `((:id ,id :chord "Control-Option-Command-M" :hotkey ,id :held nil))))
    (dolist (value (list -1 "1" 1.5 'id))
      (should-error (portal--shortcut-set value "Control-Option-Command-N"))
      (should-error (portal--shortcut-remove value)))
    (should (equal (should-error (portal--shortcut-set nil "Control-F19"))
                   '(error "Cannot register shortcut Control-F19: Another application has this chord")))
    ;; The same chord keeps its native registration under a new ID.
    (let ((same (portal--shortcut-set id "command-control-option-m")))
      (should (> same id))
      (should (equal (portal--shortcuts)
                     `((:id ,same :chord "Control-Option-Command-M" :hotkey ,id :held nil))))
      (should (equal (should-error (portal--shortcut-set id "Control-F1"))
                     '(error "That Portal shortcut was removed")))
      (should (eq (portal--shortcut-remove same) t))
      (should (eq (portal--shortcut-remove same) t))
      (should (eq (portal--shortcut-remove 0) t))))
  (should-not (portal--shortcuts)))

(defun portal-module-tests--next-id ()
  "Open and close a view; return the ID the backend gives the next one."
  (let* ((target (portal--open "terminal" '(:directory "/")))
         (id (plist-get (portal--inspect target) :id)))
    (portal--close target)
    (1+ id)))

(defmacro portal-module-tests--untouched (&rest body)
  "Run BODY and check that it opened no view in the backend."
  (declare (indent 0))
  `(let ((before (portal-module-tests--next-id)))
     ,@body
     (should (= (portal-module-tests--next-id) (1+ before)))))

(ert-deftest portal-module-registers-the-interface ()
  (should (featurep 'portal-native-module))
  (pcase-dolist (`(,name . ,arity) portal-module-tests--exports)
    (should (equal (cons name (func-arity name)) (cons name arity)))
    (should (stringp (documentation name)))))

(ert-deftest portal-module-lifecycle ()
  (let ((target (portal--open "web" '(:directory "~/Ωmega" :quick t))))
    (should (string-match-p "\\`web:[0-9]+\\'" target))
    (let ((state (portal--inspect target)))
      (should (equal (plist-get state :kind) "web"))
      (should (integerp (plist-get state :id)))
      (should (equal (plist-get state :directory) "~/Ωmega"))
      (should (eq (plist-get state :quick) t))
      (should-not (plist-get state :visible))
      (should-not (plist-get state :edges)))
    (should (eq (portal--place target [10 20 110 220] "frame ✓") t))
    (let ((state (portal--inspect target)))
      (should (equal (plist-get state :edges) '(10 20 110 220)))
      (should (equal (plist-get state :frame) "frame ✓"))
      (should (equal (plist-get state :size) '(100 200)))
      (should (eq (plist-get state :visible) t)))
    (should (eq (portal--hide target) t))
    (let ((state (portal--inspect target)))
      (should-not (plist-get state :visible))
      (should-not (plist-get state :edges))
      (should (equal (plist-get state :size) '(100 200))))
    ;; A failed placement leaves the view where it was.
    (should (equal (should-error (portal--place target [0 0 1 1] "deleted frame"))
                   '(error "Cannot find the requested native Emacs frame")))
    (should-not (plist-get (portal--inspect target) :visible))
    (should (eq (portal--close target) t))
    (should-not (portal--inspect target))
    (should (equal (should-error (portal--close target))
                   `(error ,(format "No Portal view %s" target))))))

(ert-deftest portal-module-copies-strings-exactly ()
  (let* ((text (string ?a 0 ?b ?é ?🙂))
         (target (portal--open "terminal" (list :directory "/" :name text :name "last"))))
    ;; Explicit lengths keep NUL bytes; a later duplicate option wins.
    (should (equal (plist-get (portal--inspect target) :name) "last"))
    (should (eq (portal--terminal-paste target text) t))
    (should (equal (portal--terminal-text target) text))
    (should (equal (portal--terminal-text target) (portal--terminal-text target)))
    (portal--close target)
    (setq target (portal--open "web" (list :empty "" :json (string ?\" ?\\ 0 ?é ?\n))))
    ;; Structured results cross as JSON.
    (should (equal (plist-get (portal--inspect target) :empty) ""))
    (should (equal (plist-get (portal--inspect target) :json) (string ?\" ?\\ 0 ?é ?\n)))
    (portal--close target)))

(ert-deftest portal-module-rejects-malformed-strings ()
  (let ((target (portal--open "web" nil)))
    (portal-module-tests--untouched
      (dolist (bad (list 1 'web nil [?w ?e ?b]
                         (string-to-unibyte "\377") ; Raw bytes.
                         (string #xd800)            ; A surrogate.
                         (string #x3fff80)))        ; A raw-byte character.
        (should (eq (car (should-error (portal--open bad nil))) 'wrong-type-argument))
        (should (eq (car (should-error (portal--web-load target bad))) 'wrong-type-argument))
        (when (stringp bad)
          (should (eq (car (should-error (portal--open "web" (list :a bad))))
                      'wrong-type-argument)))))
    (should-not (plist-get (portal--inspect target) :url))
    ;; ASCII unibyte strings are fine.
    (should (eq (portal--web-load target (string-to-unibyte "data:,ok")) t))
    (should (equal (plist-get (portal--inspect target) :url) "data:,ok"))
    (portal--close target)))

(ert-deftest portal-module-rejects-malformed-edges ()
  (let ((target (portal--open "web" nil)))
    (dolist (case `(((10 20 30 40) . wrong-type-argument)
                    ("abcd" . wrong-type-argument)
                    ([10 20 30] . error)
                    ([10 20 30 40 50] . error)
                    ([10 20 30 x] . wrong-type-argument)
                    ([10 20 30 1.5] . wrong-type-argument)
                    ([10 20 30 ,(expt 2 80)] . overflow-error)
                    ([10 20 5 40] . error)            ; The core checks dimensions,
                    ([0 0 ,(expt 2 40) 1] . error)))  ; and range.
      (should (eq (car (should-error (portal--place target (car case) "title"))) (cdr case))))
    (should-error (portal--place target [0 0 1 1] 'title) :type 'wrong-type-argument)
    (let ((state (portal--inspect target)))
      (should-not (plist-get state :edges))
      (should-not (plist-get state :frame))
      (should-not (plist-get state :visible)))
    (portal--close target)))

(ert-deftest portal-module-rejects-malformed-options ()
  (let ((circular (list :a "b")))
    (setcdr (cdr circular) circular)
    (portal-module-tests--untouched
      (dolist (case `((:a . "Options must be a plist")
                      ((:a) . "Options must be a plist")
                      ((:a "b" . "c") . "Options must be a plist")
                      (,circular . "Options must be a plist")
                      ([:a "b"] . "Options must be a plist")
                      ("ab" . "Options must be a plist")
                      ((a "b") . "Option names must be keywords")
                      (("a" "b") . "Option names must be keywords")
                      ((:a "b" 1 "c") . "Option names must be keywords")
                      ((:a 1) . "Option :a must be a string, t or nil")
                      ((:a web) . "Option :a must be a string, t or nil")
                      ((:a ("b")) . "Option :a must be a string, t or nil")))
        (should (equal (should-error (portal--open "web" (car case)))
                       (list 'error (cdr case))))))))

(ert-deftest portal-module-optional-arguments ()
  (let ((terminal (portal--open "terminal" '(:directory "/"))))
    (should (eq (portal--terminal-paste terminal "a") t))
    (should (eq (portal--terminal-paste terminal "b" nil) t))
    (should (eq (portal--terminal-paste terminal "c" 'enter) t))
    (should (equal (portal--terminal-text terminal) "abc\n"))
    ;; Only a shown view can have the keyboard.
    (should (eq (portal--input terminal "focus") nil))
    (portal--place terminal [0 0 10 10] "frame")
    (should (eq (portal--input terminal "focus") t))
    (should (eq (portal--input terminal "focused" nil) t))
    ;; A serial names a handoff, and there is none.
    (should (eq (portal--input terminal "focused" 7) nil))
    (should-error (portal--input terminal "command" "7") :type 'wrong-type-argument)
    (should (eq (portal--input terminal "unfocus") t))
    (should (eq (portal--input terminal "focused") nil))
    (should (eq (portal--terminal-theme "Ωmega") t))
    (should (equal (plist-get (portal--inspect terminal) :theme) "Ωmega"))
    (should (eq (portal--terminal-theme nil) t))
    (let ((state (portal--inspect terminal)))
      (should (plist-member state :theme))
      (should-not (plist-get state :theme)))
    (should-error (portal--terminal-theme 'Alpha) :type 'wrong-type-argument)
    (portal--close terminal)))

(ert-deftest portal-module-sets-web-appearance ()
  (let ((web (portal--open "web" '(:appearance "dark"))))
    (should (equal (plist-get (portal--inspect web) :appearance) "dark"))
    (should (eq (portal--web-appearance "light") t))
    (should (equal (plist-get (portal--inspect web) :appearance) "light"))
    (should (eq (portal--web-appearance nil) t))
    (let ((state (portal--inspect web)))
      (should (plist-member state :appearance))
      (should-not (plist-get state :appearance)))
    (should-error (portal--web-appearance 'dark) :type 'wrong-type-argument)
    (should (equal (should-error (portal--web-appearance "sepia"))
                   '(error "Unknown web appearance: sepia")))
    (should (equal (should-error (portal--open "web" '(:appearance t)))
                   '(error "Option :appearance must be \"light\", \"dark\" or nil")))
    (portal--close web)))

(ert-deftest portal-module-returns-backend-results ()
  ;; The core sorts the platform's names.
  (should (equal (portal--terminal-themes)
                 '("Alpha" "Back\\slash \"quoted\"" "Beta" "Ωmega")))
  (should (eq (portal--input "terminal:0" "focus") nil))
  (let ((terminal (portal--open "terminal" '(:directory "/"))))
    (should (eq (portal--input terminal "pending") nil))
    (portal--close terminal))
  (let ((binding "{\"regular\":[{\"character\":\"%s\",\"modifiers\":%d,\"event\":3}],\"quick\":[]}"))
    ;; Portal's modifiers, not a platform's: 2 is Control, and the core
    ;; compares Control-C with Control-c.
    (should (equal (should-error
                    (portal--terminal-bindings
                     (concat "{\"regular\":[{\"character\":\"c\",\"modifiers\":2,\"event\":3},"
                             "{\"character\":\"C\",\"modifiers\":2,\"event\":4}],\"quick\":[]}")))
                   '(error "Conflicting native terminal binding")))
    ;; Only ASCII first chords: the code point crosses, not a byte of it.
    (should (equal (should-error (portal--terminal-bindings (format binding "é" 8)))
                   '(error "Invalid native terminal binding")))
    (should (eq (portal--terminal-bindings (format binding "c" 2)) t)))
  (should (eq (portal--terminal-bindings "{\"regular\":[],\"quick\":[]}") t))
  (let ((page (portal--open "web" nil)))
    (should (eq (portal--web-go page "back") t))
    (should (eq (portal--web-go page "forward") t))
    (should (equal (plist-get (portal--inspect page) :history) "back forward"))
    (portal--close page))
  ;; The fake app echoes what Emacs sends it, from the page Emacs loaded.
  (let ((web (portal--open "web" '(:hosted t :echo t))))
    (should (eq (portal--web-load web "http://127.0.0.1:1/app") t))
    (should (equal (portal--web-receive web) "[]"))
    (should (eq (portal--web-send web "{\"a\":1}") t))
    (should (eq (portal--web-send web "{\"b\":\"✓\"}") t))
    (should (equal (portal--web-receive web) "[{\"a\":1},{\"b\":\"✓\"}]"))
    (should (equal (portal--web-receive web) "[]"))
    (portal--close web)))

(ert-deftest portal-module-signals-backend-errors ()
  (let ((web (portal--open "web" nil))
        (terminal (portal--open "terminal" '(:directory "/")))
        (broken (portal--open "terminal" '(:directory "/" :broken "Metal is gone"))))
    (dolist (case `(((portal--open "50%s" nil) . "Unknown Portal view kind: 50%s")
                    ((portal--open "web" (:fail "No web ✗")) . "No web ✗")
                    ((portal--open "terminal" nil) . "A terminal view needs a :directory")
                    ((portal--open "terminal" (:directory t)) . "Option :directory must be a string")
                    ((portal--open "terminal" (:directory "/" :theme "Gamma"))
                     . "Unknown terminal theme: Gamma")
                    ((portal--place "web:0" [0 0 1 1] "t") . "No Portal view web:0")
                    ((portal--hide "web:0") . "No Portal view web:0")
                    ((portal--web-load ,terminal "about:blank") . ,(format "No Portal view %s" terminal))
                    ((portal--web-send ,web "{}")
                     . ,(format "Web view %s is not a hosted app, so it has no bridge" web))
                    ((portal--web-receive ,web)
                     . ,(format "Web view %s is not a hosted app, so it has no bridge" web))
                    ((portal--terminal-paste ,web "x") . ,(format "No Portal view %s" web))
                    ((portal--terminal-text ,web) . ,(format "No Portal view %s" web))
                    ((portal--terminal-theme "Gamma") . "Unknown terminal theme: Gamma")
                    ((portal--terminal-theme "Beta") . "Metal is gone")
                    ((portal--terminal-paste ,broken "x" t) . "Metal is gone")
                    ((portal--terminal-text ,broken) . "Metal is gone")
                    ((portal--terminal-bindings "[]") . "Invalid native terminal binding")
                    ((portal--terminal-bindings "{}") . "Invalid native terminal binding")
                    ((portal--terminal-bindings "{\"regular\":[]}") . "Invalid native terminal binding")
                    ((portal--terminal-bindings "{\"regular\":[1],\"quick\":[]}")
                     . "Invalid native terminal binding")
                    ((portal--terminal-bindings
                      "{\"regular\":[],\"quick\":[{\"character\":\"x\",\"flags\":2,\"event\":120}]}")
                     . "Invalid native terminal binding")
                    ((portal--input ,web "unknown") . "Unknown Portal input action: unknown")
                    ((portal--web-go ,web "reload")
                     . "Web history step must be \"back\" or \"forward\", not reload")
                    ((portal--web-go ,terminal "back") . ,(concat "No Portal view " terminal))
                    ((portal--web-go "web:0" "back") . "No Portal view web:0")))
      (should (equal (should-error (apply (caar case) (cdar case))) (list 'error (cdr case)))))
    ;; The terminal before the one that rejected the theme has it.
    (should (equal (plist-get (portal--inspect terminal) :theme) "Beta"))
    (portal--close web)
    (portal--close terminal)
    (portal--close broken)))

(ert-deftest portal-module-keeps-the-first-pending-signal ()
  ;; Conversion stops at the first bad argument; its signal reaches Lisp intact.
  (let ((target (portal--open "web" nil)))
    (portal-module-tests--untouched
      (should (equal (should-error (portal--open 'web '(:a 1)))
                     '(wrong-type-argument stringp web))))
    (should (equal (should-error (portal--place 1 [a] 'title))
                   '(wrong-type-argument stringp 1)))
    (should (equal (should-error (portal--place target [a b c d] 'title))
                   '(wrong-type-argument integerp a)))
    (should (equal (should-error (portal--input 1 'action "serial"))
                   '(wrong-type-argument stringp 1)))
    ;; Signals leave no state behind: the next calls succeed.
    (should (eq (portal--place target [0 0 1 1] "title") t))
    (should (eq (condition-case nil (portal--hide 'target)
                  (wrong-type-argument (portal--hide target)))
                t))
    (portal--close target)))

(defun portal-module-tests--pipe (name)
  "Return a pipe process NAME that collects what it receives in its `:received'."
  (let ((process (make-pipe-process :name name :noquery t
                                    :filter (lambda (process text)
                                              (process-put process :received
                                                           (concat (process-get process :received)
                                                                   text))))))
    (process-put process :received "")
    process))

(defun portal-module-tests--await (process suffix)
  "Wait until what PROCESS received ends with SUFFIX; return all of it."
  (with-timeout (5 (ert-fail (format "Expected %S, got %S" suffix
                                     (process-get process :received))))
    (while (not (string-suffix-p suffix (process-get process :received)))
      (accept-process-output process 0.05)))
  (process-get process :received))

(ert-deftest portal-module-connects-the-channel ()
  ;; The fake app echoes what Emacs sends it, and the core announces the
  ;; echo with a bridge record through its pipe.
  (let ((first (portal-module-tests--pipe "portal-module-first"))
        (second (portal-module-tests--pipe "portal-module-second"))
        (web (portal--open "web" '(:hosted t :echo t))))
    (unwind-protect
        (let ((record (format "bridge %s\n" web)))
          (portal--web-load web "http://127.0.0.1:1/app")
          (should (eq (portal--channel first) t))
          (should (eq (portal--web-send web "{}") t))
          (let ((received (portal-module-tests--await first record)))
            (portal--web-receive web)
            ;; Records wait while no pipe is connected, and go to the next one.
            (should (eq (portal--channel nil) t))
            (should (eq (portal--web-send web "{}") t))
            (accept-process-output nil 0.1)
            (should (equal (process-get first :received) received)))
          (should (eq (portal--channel second) t))
          (should (equal (portal-module-tests--await second record) record))
          (portal--web-receive web)
          ;; A deleted reader leaves the records waiting; Emacs carries on.
          (delete-process second)
          (should (eq (portal--web-send web "{}") t))
          (should (eq (portal--channel first) t))
          (portal-module-tests--await first (concat record record))
          (should-error (portal--channel "process") :type 'wrong-type-argument))
      (portal--channel nil)
      (portal--close web)
      (delete-process first)
      (delete-process second))))

