;;; portal-agent-discovery-gui-tests.el --- Real agent smoke tests -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
;; Opt in with PORTAL_TEST_CLAUDE_DIRECTORY pointing at an already trusted project.
;; Starts plain Claude sessions, sends one harmless prompt, then exits them.
(require 'portal-gui-testing)
(declare-function portal--process-snapshot "portal-view" (variable))
(declare-function portal--terminal-paste "portal-terminal" (target text &optional enter))

(ert-deftest portal-discovery-gui-plain-claude ()
  (skip-unless (getenv "PORTAL_TEST_CLAUDE_DIRECTORY"))
  (portal-agents-gui--environment
    (let* ((default-directory (file-name-as-directory (getenv "PORTAL_TEST_CLAUDE_DIRECTORY")))
           ;; Use the promised default refresh bound, not the GUI helper's 0.2 s.
           (portal-agents-live-update-interval 2)
           (one (portal-agents-gui--open "claude-smoke-one"))
           (two (portal-agents-gui--open "claude-smoke-two"))
           (control (portal-agents-gui--open "claude-smoke-control"))
           (window (selected-window))
           (right (split-window-right))
           scan-times)
      (portal-agents-gui--wait 1)
      ;; A pre-existing plain launch must appear as soon as the dashboard opens.
      (portal-discovery-gui--type one "claude")
      (portal-agents-gui--wait 3)
      (with-selected-window right (portal-agents))
      (should (portal-agents-gui--row one))
      (should-not portal-agents--tracked)
      (portal-discovery-gui--wait
       (lambda () (equal (nth 4 (portal-agents-gui--row one)) "idle")))
      (portal-discovery-gui--type control "printf '\\033]0;✳ Claude Code\\007\\033]9;4;3\\007'; bash -c 'exec -a claude sleep 3'")
      (let ((start (float-time)))
        (portal-discovery-gui--type two "claude")
        (portal-discovery-gui--wait (lambda () (portal-agents-gui--row two)) 3)
        (message "DISCOVERY launch-to-row %.3f s" (- (float-time) start)))
      (should (= (length portal-agent-discovery--agents) 2))
      (should-not (portal-agents-gui--row control))
      (portal-discovery-gui--wait
       (lambda () (equal (nth 4 (portal-agents-gui--row two)) "idle")))
      (with-current-buffer one (rename-buffer "renamed-real-Claude"))
      (with-selected-window right
        (portal-agents-gui--visit one)
        (should (equal (portal-agents-gui--view one) (list right t)))
        (portal-agents))
      ;; A real turn exercises native title/progress -> asynchronous query -> row.
      (portal-discovery-gui--type one "Reply with exactly PORTAL_OK. Do not use tools.")
      (portal-discovery-gui--wait
       (lambda () (equal (nth 4 (portal-agents-gui--row one)) "working")) 30)
      (portal-discovery-gui--wait
       (lambda () (equal (nth 4 (portal-agents-gui--row one)) "idle")) 60)
      (dotimes (_ 50)
        (let ((start (float-time)))
          (portal--process-snapshot "PORTAL_TERMINAL")
          (push (* 1000 (- (float-time) start)) scan-times)))
      (message "DISCOVERY native scan ms mean=%.3f max=%.3f"
               (/ (apply #'+ scan-times) (length scan-times)) (apply #'max scan-times))
      ;; Hide collection while the terminals and their metadata keep running.
      (set-window-buffer right (get-buffer-create "*scratch*"))
      (portal-agents-gui--settle)
      (should-not portal-agents--timer)
      (should-not portal-agent-discovery--process)
      (portal-discovery-gui--type one "/exit")
      (portal-agents-gui--wait 3)
      (with-selected-window right (portal-agents))
      (should-not (portal-agents-gui--row one))
      (should (portal-agents-gui--row two))
      (should-not (plist-get (portal-terminal-metadata one) :exited))
      (portal-discovery-gui--type one "claude")
      (portal-discovery-gui--wait (lambda () (portal-agents-gui--row one)) 3)
      (portal-discovery-gui--type two "/exit")
      (portal-discovery-gui--wait (lambda () (not (portal-agents-gui--row two))) 5)
      ;; The selected suspension policy is exercised against a real foreground job.
      (portal-discovery-gui--wait
       (lambda () (equal (nth 4 (portal-agents-gui--row one)) "idle")))
      (signal-process (portal-agent-pid (portal-agent-discovery--find one)) 'SIGTSTP)
      (portal-discovery-gui--wait (lambda () (not (portal-agents-gui--row one))) 5)
      (portal-discovery-gui--type one "fg")
      (portal-discovery-gui--wait (lambda () (portal-agents-gui--row one)) 5)
      ;; A quick terminal is discovered and remains discoverable while hidden.
      (select-window window)
      (portal-terminal-quick--show default-directory)
      (let ((quick (current-buffer)))
        (portal-agents-gui--wait 1)
        (portal-discovery-gui--type quick "claude")
        (portal-terminal-quick-dismiss)
        (portal-discovery-gui--wait (lambda () (portal-agents-gui--row quick)) 3)
        (with-selected-window right (portal-agents-gui--visit quick))
        (should (equal (portal-agents-gui--view quick)
                       (list (portal-terminal-quick--window) t)))
        (portal-terminal-quick-dismiss)
        (should (portal-agents-gui--row quick)))
      (should-not portal-agents--tracked)
      (select-window window))))

(ert-deftest portal-discovery-gui-mixed-codex-claude ()
  ;; Both variables opt into real agents in one already trusted directory.
  (skip-unless (and (getenv "PORTAL_TEST_CODEX_DIRECTORY")
                    (getenv "PORTAL_TEST_CLAUDE_DIRECTORY")))
  (portal-agents-gui--environment
    (let* ((default-directory (file-name-as-directory (getenv "PORTAL_TEST_CODEX_DIRECTORY")))
           (portal-agents-live-update-interval 2)
           (codex (portal-agents-gui--open "codex-smoke"))
           (claude (portal-agents-gui--open "claude-mixed-smoke"))
           (control (portal-agents-gui--open "codex-control"))
           (window (selected-window))
           (right (split-window-right)))
      (portal-agents-gui--wait 1)
      (portal-discovery-gui--type codex "codex")
      (portal-discovery-gui--type claude "claude")
      (portal-agents-gui--wait 4)
      (with-selected-window right (portal-agents))
      (should (equal (nth 1 (portal-agents-gui--row codex)) "Codex (title)"))
      (should (equal (nth 1 (portal-agents-gui--row claude)) "Claude"))
      (portal-discovery-gui--wait
       (lambda () (equal (nth 4 (portal-agents-gui--row claude)) "idle")))
      (portal-discovery-gui--wait
       (lambda () (equal (nth 4 (portal-agents-gui--row codex)) "idle")))
      (portal-discovery-gui--type control
                                "printf '\\033]0;[ ! ] Action Required | portal\\007\\033]9;4;3\\007'; bash -c 'exec -a codex sleep 5'")
      (portal-discovery-gui--type codex "Reply with exactly PORTAL_OK. Do not use tools.")
      (let ((start (float-time)))
        (portal-discovery-gui--wait
         (lambda () (equal (nth 4 (portal-agents-gui--row codex)) "working")) 30)
        (message "CODEX prompt-to-working %.3f s" (- (float-time) start)))
      (should (equal (nth 4 (portal-agents-gui--row claude)) "idle"))
      (should-not (portal-agents-gui--row control))
      (portal-discovery-gui--wait
       (lambda () (equal (nth 4 (portal-agents-gui--row codex)) "idle")) 60)
      (with-selected-window right
        (portal-agents-gui--visit codex)
        (should (equal (portal-agents-gui--view codex) (list right t)))
        (portal-agents))
      (set-window-buffer right (get-buffer-create "*scratch*"))
      (portal-agents-gui--settle)
      (should-not portal-agents--timer)
      (should-not portal-agent-discovery--process)
      (portal-discovery-gui--type codex "/quit")
      (portal-agents-gui--wait 3)
      (with-selected-window right (portal-agents))
      (should-not (portal-agents-gui--row codex))
      (should (portal-agents-gui--row claude))
      (should-not (plist-get (portal-terminal-metadata codex) :exited))
      (let ((start (float-time)))
        (portal-discovery-gui--type codex "codex")
        (portal-discovery-gui--wait (lambda () (portal-agents-gui--row codex)) 3)
        (message "CODEX launch-to-row %.3f s" (- (float-time) start)))
      (select-window window)
      (portal-terminal-quick--show default-directory)
      (let ((quick (current-buffer)))
        (portal-agents-gui--wait 1)
        (portal-discovery-gui--type quick "codex")
        (portal-terminal-quick-dismiss)
        (portal-discovery-gui--wait (lambda () (portal-agents-gui--row quick)) 3)
        (should (= (length portal-agent-discovery--agents) 3))
        (with-selected-window right (portal-agents-gui--visit quick))
        (should (equal (portal-agents-gui--view quick)
                       (list (portal-terminal-quick--window) t)))
        (portal-terminal-quick-dismiss)
        (should (portal-agents-gui--row quick)))
      (should-not portal-agents--tracked)
      (select-window window))))

(ert-deftest portal-discovery-gui-mixed-pi-claude-codex ()
  ;; Use a disposable Pi agent directory with portal-pi.ts installed once;
  ;; no per-session flags or registration, and no edits to the user's settings.
  (skip-unless (and (getenv "PORTAL_TEST_PI_AGENT_DIR")
                    (getenv "PORTAL_TEST_CLAUDE_DIRECTORY")))
  (portal-agents-gui--environment
    (let* ((default-directory (file-name-as-directory (getenv "PORTAL_TEST_CLAUDE_DIRECTORY")))
           (portal-agents-pi-progress t)
           (portal-agents-live-update-interval 2)
           (pi (portal-agents-gui--open "pi-smoke"))
           (claude (portal-agents-gui--open "pi-claude-smoke"))
           (codex (and (getenv "PORTAL_TEST_CODEX_DIRECTORY") (portal-agents-gui--open "pi-codex-smoke")))
           (control (portal-agents-gui--open "pi-control"))
           (window (selected-window))
           (right (split-window-right))
           (setup (concat "export PI_CODING_AGENT_DIR=" (shell-quote-argument (getenv "PORTAL_TEST_PI_AGENT_DIR")))))
      (portal-agents-gui--wait 1)
      (portal-discovery-gui--type pi setup)
      (portal-discovery-gui--type pi "pi")
      (portal-discovery-gui--type claude "claude")
      (when codex (portal-discovery-gui--type codex "codex"))
      (portal-agents-gui--wait 4)
      ;; Pi was already running with the dashboard unopened; identity is found
      ;; immediately, while its old startup progress remains untrusted.
      (with-selected-window right (portal-agents))
      (should (equal (nth 1 (portal-agents-gui--row pi)) "Pi (progress)"))
      (portal-discovery-gui--wait
       (lambda () (string-prefix-p "π -" (or (buffer-local-value 'portal-terminal--title pi) ""))))
      (should (equal (nth 4 (portal-agents-gui--row pi)) "unknown"))
      (portal-discovery-gui--type pi "/new")
      (portal-discovery-gui--wait (lambda () (equal (nth 4 (portal-agents-gui--row pi)) "idle")))
      (portal-discovery-gui--wait (lambda () (equal (nth 4 (portal-agents-gui--row claude)) "idle")))
      (when codex (should (equal (nth 1 (portal-agents-gui--row codex)) "Codex (title)")))
      (portal-discovery-gui--type control "printf '\\033]0;π - portal\\007\\033]9;4;3\\007'")
      (let ((start (float-time)))
        (portal-discovery-gui--type pi "Use the bash tool to run exactly: sleep 3. Then reply PORTAL_OK.")
        (portal-discovery-gui--wait (lambda () (equal (nth 4 (portal-agents-gui--row pi)) "working")) 30)
        (message "PI prompt-to-working %.3f s" (- (float-time) start)))
      (should (equal (nth 4 (portal-agents-gui--row claude)) "idle"))
      (should-not (portal-agents-gui--row control))
      (portal-discovery-gui--wait (lambda () (equal (nth 4 (portal-agents-gui--row pi)) "idle")) 60)
      (with-selected-window right
        (portal-agents-gui--visit pi)
        (should (equal (portal-agents-gui--view pi) (list right t)))
        (portal-agents))
      ;; A real extension dialog, not a fabricated terminal progress sequence.
      (portal-discovery-gui--type pi "/portal-test-prompt")
      (portal-discovery-gui--wait (lambda () (equal (nth 4 (portal-agents-gui--row pi)) "waiting")))
      (portal-discovery-gui--type pi "PORTAL_OK")
      (portal-discovery-gui--wait (lambda () (equal (nth 4 (portal-agents-gui--row pi)) "idle")))
      (set-window-buffer right (get-buffer-create "*scratch*"))
      (portal-agents-gui--settle)
      (should-not portal-agents--timer)
      (should-not portal-agent-discovery--process)
      (portal-discovery-gui--type pi "/portal-test-prompt")
      (portal-agents-gui--wait 2)
      (with-selected-window right (portal-agents))
      (should (equal (nth 4 (portal-agents-gui--row pi)) "waiting"))
      (portal-discovery-gui--type pi "PORTAL_OK")
      (portal-discovery-gui--wait (lambda () (equal (nth 4 (portal-agents-gui--row pi)) "idle")))
      (let ((time (buffer-local-value 'portal-terminal--progress-time pi)))
        (portal-discovery-gui--type pi "/reload")
        (portal-discovery-gui--wait (lambda () (> (buffer-local-value 'portal-terminal--progress-time pi) time)))
        (portal-discovery-gui--wait (lambda () (equal (nth 4 (portal-agents-gui--row pi)) "idle"))))
      (portal-discovery-gui--type pi "/quit")
      (portal-discovery-gui--wait (lambda () (not (portal-agents-gui--row pi))) 5)
      (let ((start (float-time)))
        (portal-discovery-gui--type pi "pi")
        (portal-discovery-gui--wait (lambda () (portal-agents-gui--row pi)) 5)
        (message "PI launch-to-row %.3f s" (- (float-time) start)))
      ;; A quick Pi session shares the same directory and stays observed hidden.
      (select-window window)
      (portal-terminal-quick--show default-directory)
      (let ((quick (current-buffer)))
        (portal-agents-gui--wait 1)
        (portal-discovery-gui--type quick setup)
        (portal-discovery-gui--type quick "pi")
        (portal-terminal-quick-dismiss)
        (portal-discovery-gui--wait (lambda () (portal-agents-gui--row quick)) 5)
        (should (= (length portal-agent-discovery--agents) (if codex 4 3)))
        (with-selected-window right (portal-agents-gui--visit quick))
        (should (equal (portal-agents-gui--view quick) (list (portal-terminal-quick--window) t)))
        (portal-terminal-quick-dismiss))
      (should-not portal-agents--tracked)
      (select-window window))))

(provide 'portal-agent-discovery-gui-tests)
;;; portal-agent-discovery-gui-tests.el ends here
