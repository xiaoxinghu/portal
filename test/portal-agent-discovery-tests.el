;;; portal-agent-discovery-tests.el --- Discovery through dashboard rows -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'portal-agents-testing
         (expand-file-name "portal-agents-testing"
                           (file-name-directory
                            (or load-file-name
                                (bound-and-true-p byte-compile-current-file)
                                buffer-file-name))))
(declare-function portal--process-snapshot "portal-view" (variable))

(defvar portal-discovery-test--processes nil)
(defvar portal-discovery-test--queries 0)
(defconst portal-discovery-test--fixtures
  (expand-file-name "fixtures/agent-signals/" (file-name-directory (or load-file-name (bound-and-true-p byte-compile-current-file) buffer-file-name))))

(defmacro portal-discovery-test--environment (&rest body)
  "Run BODY with real query pipes and controllable native process snapshots."
  (declare (indent 0))
  `(portal-agents-test--environment
     (let ((portal-agent-discovery--agents nil)
           (portal-agent-discovery--hidden nil)
           (portal-agent-discovery--queried 0)
           (portal-agent-discovery--pending nil)
           (portal-discovery-test--processes nil)
           (portal-discovery-test--queries 0)
           (make (symbol-function 'make-process)))
       (cl-letf (((symbol-function 'portal--process-snapshot)
                  (lambda (variable)
                    (should (equal variable "PORTAL_TERMINAL"))
                    portal-discovery-test--processes))
                 ((symbol-function 'make-process)
                  (lambda (&rest args)
                    (should (equal (plist-get args :command) '("claude" "agents" "--json")))
                    (cl-incf portal-discovery-test--queries)
                    ;; A real pipe/filter/sentinel, with explicitly delivered JSON.
                    (apply make (plist-put args :command '("/bin/cat"))))))
         (unwind-protect (progn ,@body)
           (portal-agent-discovery--stop))))))

(defun portal-discovery-test--process (buffer pid &optional start)
  "Process snapshot entry for BUFFER, PID and START."
  (list :pid pid :start (or start "100.000001")
        :tty-parent (emacs-pid)
        :environment (format "%d/%s" (emacs-pid) (buffer-local-value 'portal-view--target buffer))
        :executable "/home/test/.local/share/claude/versions/2.1.287"
        :argv '("claude") :ancestors '(1)))

(defun portal-discovery-test--reply (text)
  "Complete the current query with TEXT and run its sentinel."
  (let ((process portal-agent-discovery--process)
        (end (+ (float-time) 2)))
    (should (process-live-p process))
    (process-send-string process text)
    (process-send-eof process)
    (while (and (eq process portal-agent-discovery--process) (< (float-time) end))
      (accept-process-output nil 0.01))
    (should-not (eq process portal-agent-discovery--process))))

(defun portal-discovery-test--status (buffer)
  "Activity in BUFFER's actual dashboard row."
  (nth 4 (portal-agents-test--row buffer)))

(defun portal-discovery-test--codex (buffer pid &optional start)
  "Codex process snapshot entry for BUFFER, PID and START."
  (let ((process (portal-discovery-test--process buffer pid start)))
    (plist-put process :executable "/opt/bin/codex")
    (plist-put process :argv '("codex"))))

(defun portal-discovery-test--pi (buffer pid &optional start)
  "Pi's renamed Node process for BUFFER, PID and START."
  (let ((process (portal-discovery-test--process buffer pid start)))
    (plist-put process :executable "/opt/bin/node")
    (plist-put process :argv '("pi" "" ""))))

(defun portal-discovery-test--progress (buffer state &optional time)
  "Deliver STATE received at native TIME, defaulting to now, to BUFFER."
  (portal-agents-test--report buffer :progress state
                              :progress-time (or time (floor (* 1000000 (float-time))))))

(ert-deftest portal-discovery-pi-identity-source-and-negative-controls ()
  (portal-discovery-test--environment
    (let ((pi (portal-agents-test--open "one/app"))
          (control (portal-agents-test--open "one/app"))
          (portal-agents-discover-claude nil)
          (portal-agents-discover-codex nil)
          (portal-agents-pi-progress nil))
      (setq portal-discovery-test--processes
            (list (portal-discovery-test--pi pi 10)
                  (plist-put (portal-discovery-test--pi control 20) :executable "/bin/sleep")))
      (portal-agents-test--report pi :title "π - app")
      (portal-discovery-test--progress pi "remove")
      (portal-agents-test--show)
      (should (equal (nth 1 (portal-agents-test--row pi)) "Pi (progress)"))
      (should (equal (portal-discovery-test--status pi) "unknown"))
      (should (string-match-p "needs" (get-text-property 0 'help-echo (portal-discovery-test--status pi))))
      (let ((portal-agents-pi-progress t))
        ;; An old startup report cannot initialize a discovered run.
        (portal-agents--tick)
        (should (equal (portal-discovery-test--status pi) "unknown"))
        (pcase-dolist (`(,state ,expected)
                      '(("remove" "idle") ("indeterminate" "working") ("pause" "waiting")
                        ("error" "unknown") ("normal" "unknown") (nil "unknown")))
          (portal-discovery-test--progress pi state)
          (portal-discovery-test--progress control state)
          (portal-agents--tick)
          (should (equal (portal-discovery-test--status pi) expected))
          (should-not (portal-agents-test--row control))))
      (let ((portal-agents-discover-pi nil))
        (portal-agents--tick)
        (should-not (portal-agents-test--row pi)))
      (should (= portal-discovery-test--queries 0)))))

(ert-deftest portal-discovery-pi-hidden-manual-freshness-and-no-redraw ()
  (portal-discovery-test--environment
    (let ((pi (portal-agents-test--open "one/app")) (portal-agents-pi-progress t))
      (setq portal-discovery-test--processes (list (portal-discovery-test--pi pi 10)))
      (portal-agents-test--show)
      (portal-discovery-test--progress pi "indeterminate")
      (portal-agents--tick)
      (should (equal (portal-discovery-test--status pi) "working"))
      ;; Fresh receipt of the same progress must not redraw unchanged facts.
      (cl-letf (((symbol-function 'portal-agents--print) (lambda (_) (ert-fail "Same progress redrew table"))))
        (portal-discovery-test--progress pi "indeterminate")
        (portal-agents--tick))
      (switch-to-buffer pi)
      (portal-agents-test--redisplay)
      (should-not portal-agents--timer)
      (cl-letf (((symbol-function 'portal--process-snapshot) (lambda (_) (ert-fail "Hidden scan"))))
        (portal-discovery-test--progress pi "pause")
        (portal-agent-discovery--collect))
      (portal-agents-test--show)
      (should (equal (portal-discovery-test--status pi) "waiting"))
      (portal-agents-toggle-live-update -1)
      (should (equal (portal-discovery-test--status pi) "unknown"))
      (portal-discovery-test--progress pi "remove")
      (with-current-buffer portal-agents--buffer (revert-buffer))
      (should (equal (portal-discovery-test--status pi) "idle"))
      (should-not portal-agents--timer))))

(ert-deftest portal-discovery-pi-incarnations-delayed-metadata-and-retracking ()
  (portal-discovery-test--environment
    (let ((pi (portal-agents-test--open "one/app")) (portal-agents-pi-progress t))
      (setq portal-discovery-test--processes (list (portal-discovery-test--pi pi 10)))
      (portal-agents-test--show)
      (portal-discovery-test--progress pi "remove")
      (portal-agents--tick)
      (let ((old-time (buffer-local-value 'portal-terminal--progress-time pi)))
        (setq portal-discovery-test--processes (list (portal-discovery-test--pi pi 10 "200.000002")))
        (portal-agents--tick)
        (should (equal (portal-discovery-test--status pi) "unknown"))
        ;; Metadata delivery after discovery is not a new native report.
        (portal-discovery-test--progress pi "indeterminate" old-time)
        (portal-agents--tick)
        (should (equal (portal-discovery-test--status pi) "unknown")))
      (portal-discovery-test--progress pi "pause")
      (portal-agents--tick)
      (should (equal (portal-discovery-test--status pi) "waiting"))
      (portal-agents-untrack pi)
      (portal-discovery-test--progress pi "remove")
      (portal-agents-track pi "Pi reviewer")
      (should (equal (portal-discovery-test--status pi) "unknown"))
      (portal-discovery-test--progress pi "remove")
      (portal-agents--tick)
      (should (equal (portal-discovery-test--status pi) "idle"))
      (should (= (length (portal-agents-test--rows)) 1))
      (setq portal-discovery-test--processes nil)
      (portal-agents--tick)
      (portal-discovery-test--progress pi "indeterminate")
      (portal-agents--tick)
      ;; Manual row survives exit but never inherits agent activity.
      (should (equal (portal-discovery-test--status pi) "unknown"))
      (portal-agents-untrack pi)
      (should-not (portal-agents-test--row pi)))))

(ert-deftest portal-discovery-pi-mixed-sources-and-failure-recovery ()
  (portal-discovery-test--environment
    (let ((pi (portal-agents-test--open "one/app"))
          (claude (portal-agents-test--open "one/app"))
          (codex (portal-agents-test--open "one/app"))
          (portal-agents-pi-progress t))
      (setq portal-discovery-test--processes
            (list (portal-discovery-test--pi pi 10) (portal-discovery-test--process claude 20)
                  (portal-discovery-test--codex codex 30)))
      (portal-agents-test--report codex :title "⠋ project")
      (portal-agents-test--show)
      (portal-discovery-test--progress pi "pause")
      (should-not portal-agent-discovery--pending)
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"},{\"pid\":20,\"status\":\"idle\"}]")
      (should (equal (portal-discovery-test--status pi) "waiting"))
      (should (equal (portal-discovery-test--status claude) "idle"))
      (should (equal (portal-discovery-test--status codex) "working"))
      (cl-letf (((symbol-function 'portal--process-snapshot) (lambda (_) (error "offline"))))
        (portal-agents--tick)
        (should (equal (portal-discovery-test--status pi) "unknown")))
      (portal-agents--tick)
      (should (equal (portal-discovery-test--status pi) "waiting"))
      (portal-agent-discovery--collect t)
      (portal-discovery-test--reply "invalid")
      (should (equal (portal-discovery-test--status pi) "waiting"))
      (portal-discovery-test--progress pi "error")
      (portal-agents--tick)
      (should (equal (portal-discovery-test--status pi) "unknown")))))

(ert-deftest portal-discovery-replays-real-pi-progress-through-rows ()
  (portal-discovery-test--environment
    (let* ((pi (portal-agents-test--open "one/app"))
           (portal-agents-pi-progress t)
           (events (with-temp-buffer
                     (insert-file-contents (expand-file-name "pi-progress-extension.jsonl" portal-discovery-test--fixtures))
                     (mapcar (lambda (line) (json-parse-string line :object-type 'plist))
                             (split-string (buffer-string) "\n" t))))
           (checkpoints '(("after-turn" . "idle") ("cancel" . "working") ("after-cancel" . "idle"))))
      (portal-agents-test--show)
      (dolist (event events)
        (pcase (plist-get event :kind)
          ("spawn" (setq portal-discovery-test--processes (list (portal-discovery-test--pi pi 10)))
           (portal-agents--tick))
          ("progress"
           (portal-discovery-test--progress pi (cdr (assq (plist-get event :state)
                                                          '((0 . "remove") (3 . "indeterminate") (4 . "pause")))))
           (portal-agents--tick))
          ("step"
           (when-let* ((checkpoint (assoc (plist-get event :label) checkpoints)))
             (should (equal (portal-discovery-test--status pi) (cdr checkpoint)))
             (setq checkpoints (delq checkpoint checkpoints))))
          ("exit" (setq portal-discovery-test--processes nil) (portal-agents--tick)
           (should-not (portal-agents-test--row pi)))))
      (should-not checkpoints)
      (should (= portal-discovery-test--queries 0)))))

(ert-deftest portal-discovery-codex-titles-and-controls ()
  (portal-discovery-test--environment
    (let ((terminal (portal-agents-test--open "one/app"))
          (control (portal-agents-test--open "one/app"))
          (portal-agents-discover-claude nil))
      (setq portal-discovery-test--processes
            (list (portal-discovery-test--codex terminal 10)
                  (plist-put (portal-discovery-test--codex control 20) :executable "/bin/sleep")))
      (portal-agents-test--show)
      (should (equal (nth 1 (portal-agents-test--row terminal)) "Codex (title)"))
      (pcase-dolist (`(,title ,expected)
                    '((nil "unknown") ("" "unknown") ("  " "unknown")
                      ("⠀ project" "working") ("⣿ project" "working")
                      ("⠋ project" "working") ("[ . ] Action Required | project" "waiting")
                      ("[ ! ] Action Required | project" "waiting") ("project" "idle")
                      ("◐ project" "idle") ("✳ Claude Code" "idle") (nil "unknown")))
        (portal-agents-test--report terminal :title title :progress "indeterminate")
        (portal-agents-test--report control :title title :progress "indeterminate")
        (portal-agents--tick)
        (should (equal (portal-discovery-test--status terminal) expected))
        (should-not (portal-agents-test--row control))
        (should (string-match-p (if (equal expected "unknown") "No Codex" "Inferred")
                                (get-text-property 0 'help-echo (portal-discovery-test--status terminal)))))
      (should (= portal-discovery-test--queries 0))
      (should-not portal-agent-discovery--process))))

(ert-deftest portal-discovery-codex-mixed-sources-and-independent-options ()
  (portal-discovery-test--environment
    (let ((claude (portal-agents-test--open "one/app"))
          (codex (portal-agents-test--open "one/app")))
      (setq portal-discovery-test--processes
            (list (portal-discovery-test--process claude 10) (portal-discovery-test--codex codex 20)))
      (portal-agents-test--report codex :title "⠋ project")
      (portal-agents-test--show)
      (should (equal (mapcar (lambda (r) (portal-agent-name (car r)))
                             (process-get portal-agent-discovery--process 'requested)) '("claude")))
      (portal-agents-test--report codex :title "[ ! ] Action Required | project")
      (should-not portal-agent-discovery--pending)
      ;; Even a response containing Codex's PID must not supply its activity.
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"},{\"pid\":20,\"status\":\"idle\"}]")
      (should (equal (portal-discovery-test--status claude) "working"))
      (should (equal (portal-discovery-test--status codex) "waiting"))
      (portal-agent-discovery--collect t)
      (portal-discovery-test--reply "invalid")
      (should (equal (portal-discovery-test--status claude) "unknown"))
      (should (equal (portal-discovery-test--status codex) "waiting"))
      (portal-agents-track codex "Reviewer")
      (should (= (length (portal-agents-test--rows)) 2))
      (should (equal (nth 1 (portal-agents-test--row codex)) "Reviewer"))
      (portal-agent-discovery--collect t)
      (let ((portal-agents-discover-claude nil))
        (portal-agents--tick)
        (should-not portal-agent-discovery--process)
        (should-not (portal-agents-test--row claude))
        (should (equal (portal-discovery-test--status codex) "waiting")))
      (let ((portal-agents-discover-codex nil))
        (portal-agents--tick)
        (should (equal (portal-discovery-test--status codex) "unknown"))
        (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"idle\"}]")
        (should (equal (portal-discovery-test--status claude) "idle"))))))

(ert-deftest portal-discovery-codex-incarnations-and-source-loss ()
  (portal-discovery-test--environment
    (let* ((terminal (portal-agents-test--open "one/app"))
           (process (portal-discovery-test--codex terminal 10)))
      (setq portal-discovery-test--processes (list process))
      (portal-agents-test--report terminal :title "⠋ project")
      (portal-agents-test--show)
      (cl-letf (((symbol-function 'portal--process-snapshot) (lambda (_) (error "unavailable"))))
        (portal-agents--tick)
        (portal-agents-test--report terminal :title "project")
        (should (equal (portal-discovery-test--status terminal) "unknown"))
        (should (equal (nth 3 (portal-agents-test--row terminal)) "unknown")))
      (portal-agents--tick)
      (should (equal (portal-discovery-test--status terminal) "idle"))
      (portal-agents-untrack terminal)
      (let ((portal-agents-discover-codex nil)) (portal-agents--tick))
      (portal-agents--tick)
      (should-not (portal-agents-test--row terminal))
      ;; PID reuse is a new run and must not inherit the hidden identity.
      (setq portal-discovery-test--processes (list (portal-discovery-test--codex terminal 10 "200.000002")))
      (portal-agents-test--report terminal :title nil)
      (portal-agents--tick)
      (should (equal (portal-discovery-test--status terminal) "unknown"))
      (setq portal-discovery-test--processes nil)
      (portal-agents--tick)
      (portal-agents-test--report terminal :title "⠋ late title")
      (portal-agents--tick)
      (should-not (portal-agents-test--row terminal))
      ;; A delayed Claude answer cannot update a new Codex in the same shell.
      (setq portal-discovery-test--processes (list (portal-discovery-test--process terminal 10)))
      (portal-agents--tick)
      (setq portal-discovery-test--processes (list process))
      (portal-agents-test--report terminal :title "[ . ] Action Required | project")
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"}]")
      (should (equal (portal-discovery-test--status terminal) "waiting"))
      (with-current-buffer terminal
        (portal-terminal-close)
        (portal-terminal-mode)
        (portal-view-open 'terminal (list :directory default-directory)))
      (portal-agents--tick)
      (should-not (portal-agents-test--row terminal)))))

