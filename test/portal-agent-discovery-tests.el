(ert-deftest portal-discovery-replays-real-codex-fixtures-through-rows ()
  (pcase-dolist (`(,fixture . ,checkpoints)
                '(("codex-approval.jsonl" ("first-prompt" . "idle") ("approval-1" . "waiting")
                   ("after-turn-2" . "idle") ("approval-2" . "waiting")
                   ("after-deny" . "idle") ("cancel" . "working") ("after-cancel" . "idle"))
                  ("codex-model-error.jsonl" ("after-failure" . "idle"))
                  ("codex-turn-notification.jsonl" ("first-prompt" . "idle") ("after-turn-1" . "idle"))))
    (portal-discovery-test--environment
      (let* ((terminal (portal-agents-test--open "one/app"))
             (events (with-temp-buffer
                       (insert-file-contents (expand-file-name fixture portal-discovery-test--fixtures))
                       (mapcar (lambda (line) (json-parse-string line :object-type 'plist))
                               (split-string (buffer-string) "\n" t))))
             working)
        (portal-agents-test--show)
        (dolist (event events)
          (pcase (plist-get event :kind)
            ("spawn" (setq portal-discovery-test--processes (list (portal-discovery-test--codex terminal 10)))
             (portal-agents--tick)
             (should (equal (portal-discovery-test--status terminal) "unknown")))
            ("title" (portal-agents-test--report terminal :title (plist-get event :title))
             (portal-agents--tick)
             (when (equal (portal-discovery-test--status terminal) "working") (setq working t)))
            ("step"
             (when-let* ((checkpoint (assoc (plist-get event :label) checkpoints)))
               (ert-info ((format "%s: %s" fixture (car checkpoint)))
                 (should (equal (portal-discovery-test--status terminal) (cdr checkpoint))))
               (setq checkpoints (delq checkpoint checkpoints))))
            ("exit" (setq portal-discovery-test--processes nil) (portal-agents--tick)
             (should-not (portal-agents-test--row terminal)))))
        (should working)
        (should-not checkpoints)
        (should (= portal-discovery-test--queries 0))))))

(ert-deftest portal-discovery-identities-controls-and-manual-policy ()
  (portal-discovery-test--environment
    (let* ((one (portal-agents-test--open "one/app"))
           (two (portal-agents-test--open "one/app"))
           (control (portal-agents-test--open "two/app"))
           (first (portal-discovery-test--process one 10))
           (second (portal-discovery-test--process two 20))
           (fake (plist-put (portal-discovery-test--process control 30) :executable "/bin/sleep")))
      (portal-agents-test--report control :title "✳ Claude Code" :progress "indeterminate")
      (setq portal-discovery-test--processes (list first second fake))
      (portal-agents-test--show)
      (should (= (length (portal-agents-test--rows)) 2))
      (should (equal (portal-discovery-test--status one) "unknown"))
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"},{\"pid\":20,\"status\":\"waiting\"}]")
      (should (equal (portal-discovery-test--status one) "working"))
      (should (equal (portal-discovery-test--status two) "waiting"))
      (with-current-buffer one (rename-buffer "renamed Claude"))
      (portal-agents-test--report one :pwd (portal-agents-test--path "two/app"))
      (portal-agents--tick)
      (should (equal (car (portal-agents-test--row one)) "renamed Claude"))
      (with-current-buffer one
        (cl-letf (((symbol-function 'read-buffer)
                   (lambda (_prompt default _match predicate)
                     (should (eq default one))
                     (should (funcall predicate (cons (buffer-name one) one)))
                     (buffer-name one))))
          (call-interactively #'portal-agents-untrack)))
      (portal-agents--tick)
      (should-not (portal-agents-test--row one))
      (portal-agents-track one "My reviewer")
      (should (equal (nth 1 (portal-agents-test--row one)) "My reviewer"))
      (should (= (length (portal-agents-test--rows)) 2))
      (portal-agents-untrack one)
      (setq portal-discovery-test--processes (list second))
      (portal-agents--tick)
      (setq portal-discovery-test--processes (list (portal-discovery-test--process one 11) second))
      (portal-agents--tick)
      (should (equal (portal-discovery-test--status one) "unknown"))
      (should (equal (nth 1 (portal-agents-test--row one)) "Claude")))))

(ert-deftest portal-discovery-retracking-requires-fresh-status ()
  (dolist (live '(nil t))
    ;; A request from before untracking may finish while hidden or retracked.
    (dolist (completion '(nil hidden retracked))
      (portal-discovery-test--environment
        (let ((portal-agents-live-update live)
              (terminal (portal-agents-test--open "one/app")))
          (setq portal-discovery-test--processes (list (portal-discovery-test--process terminal 10)))
          (portal-agents-test--show)
          (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"}]")
          (should (equal (portal-discovery-test--status terminal) "working"))
          (when completion (portal-agent-discovery--collect t))
          (portal-agents-untrack terminal)
          (should-not (portal-agents-test--row terminal))
          (when (eq completion 'hidden)
            (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"}]"))
          ;; No title or progress change: the gap alone invalidates activity.
          (portal-agents-track terminal "My reviewer")
          (should (equal (portal-discovery-test--status terminal) "unknown"))
          (when (eq completion 'retracked)
            (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"}]")
            (should (equal (portal-discovery-test--status terminal) "unknown")))
          (portal-agents--tick)
          (unless live
            (should-not portal-agent-discovery--process)
            (with-current-buffer portal-agents--buffer (revert-buffer)))
          (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"idle\"}]")
          (should (equal (portal-discovery-test--status terminal) "idle"))
          (should (equal (nth 1 (portal-agents-test--row terminal)) "My reviewer"))
          ;; Merely changing a visible run's label preserves verified activity.
          (let ((queries portal-discovery-test--queries))
            (portal-agents-track terminal "Renamed reviewer")
            (portal-agents--tick)
            (should (equal (portal-discovery-test--status terminal) "idle"))
            (should (= portal-discovery-test--queries queries))))))))

