From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xiaoxing Hu <hi@xiaoxing.dev>
Date: Thu, 19 Nov 2026 20:32:39 +1300
Subject: [PATCH 1/4] build: link the GL and EGL loaders into an OpenGL library

A library built with -Dapp-runtime=none for an OpenGL target refers to
glad's symbols (gladLoadGLContext, gladLoadEGL and the rest) and does not
contain them: glad is compiled into executables only, and EGL only for
GTK. Nothing can link the library as built.

Compile glad into a library whose renderer is OpenGL too, and the EGL
loader with it.
---
 src/build/SharedDeps.zig | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/build/SharedDeps.zig b/src/build/SharedDeps.zig
index 8f4e23954..d6d4747e8 100644
--- a/src/build/SharedDeps.zig
+++ b/src/build/SharedDeps.zig
@@ -654,7 +654,10 @@ pub fn add(
     }
 
     // If we're building an exe then we have additional dependencies.
-    if (step.kind != .lib) {
+    // A library rendering with OpenGL (Linux) needs the GL and EGL
+    // loaders too: its host presents frames, so nothing else links them.
+    const opengl_lib = step.kind == .lib and self.config.renderer == .opengl;
+    if (step.kind != .lib or opengl_lib) {
         // We always statically compile glad
         step.root_module.addIncludePath(b.path("vendor/glad/include/"));
         step.root_module.addCSourceFile(.{
@@ -662,8 +665,8 @@ pub fn add(
             .flags = &.{},
         });
 
-        // Link EGL for GTK.
-        if (self.config.app_runtime == .gtk) {
+        // Link EGL for GTK, and for an OpenGL library.
+        if (self.config.app_runtime == .gtk or opengl_lib) {
             step.root_module.addCSourceFile(.{
                 .file = b.path("vendor/glad/src/glad_egl.c"),
                 .flags = &.{},
