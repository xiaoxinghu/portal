     }
 
     /// Create a new app.
@@ -2456,6 +2503,89 @@ pub const CAPI = struct {
     extern "c" fn CGSSetWindowBackgroundBlurRadius(*anyopaque, usize, c_int) i32;
     extern "c" fn CGSDefaultConnectionForThread() *anyopaque;
 
+    // Linux-only C APIs: the host presents the renderer's frames.
+    const Linux = struct {
+        const ExportedFrame = renderer.Renderer.ExportedFrame;
+
+        /// ghostty_frame_s, and the frame it describes, which owns
+        /// the fds and the hold on their texture, or the pixels.
+        const Frame = struct {
+            c: C,
+            inner: ExportedFrame,
+
+            /// ghostty_frame_kind_e
+            const Kind = enum(c_int) {
+                dmabuf = 1,
+                memory = 2,
+            };
+
+            const C = extern struct {
+                kind: Kind,
+                width: u32,
+                height: u32,
+                // Both kinds are read out of GL, whose first row is
+                // the bottom one.
+                bottom_up: bool = !renderer.Renderer.custom_shader_y_is_down,
+                premultiplied: bool,
+                texture: u64 = 0,
+                fourcc: u32 = 0,
+                modifier: u64 = 0,
+                plane_count: u32 = 0,
+                fds: [4]c_int = @splat(-1),
+                offsets: [4]u32 = @splat(0),
+                strides: [4]u32 = @splat(0),
+                pixels: ?[*]const u8 = null,
+            };
+        };
+
+        export fn ghostty_surface_take_frame(ptr: *Surface) ?*Frame.C {
+            const inner = ptr.core_surface.renderer.takeFrame() orelse return null;
+            const frame = global.alloc().create(Frame) catch {
+                inner.deinit();
+                return null;
+            };
+            frame.* = .{ .inner = inner, .c = switch (inner) {
+                .dmabuf => |d| c: {
+                    var c: Frame.C = .{
+                        .kind = .dmabuf,
+                        .width = d.width,
+                        .height = d.height,
+                        .premultiplied = d.premultiplied,
+                        .texture = d.texture,
+                        .fourcc = d.fourcc,
+                        .modifier = d.modifier,
+                        .plane_count = d.planes.count,
+                    };
+                    for (0..d.planes.count) |i| {
+                        c.fds[i] = d.planes.fds[i];
+                        c.offsets[i] = @intCast(d.planes.offsets[i]);
+                        c.strides[i] = @intCast(d.planes.strides[i]);
+                    }
+                    break :c c;
+                },
+                .memory => |m| .{
+                    .kind = .memory,
+                    .width = m.width,
+                    .height = m.height,
+                    .premultiplied = true,
+                    .pixels = m.pixels.ptr,
+                },
+            } };
+            return &frame.c;
+        }
+
+        export fn ghostty_frame_free(ptr: ?*Frame.C) void {
+            const c = ptr orelse return;
+            const frame: *Frame = @fieldParentPtr("c", c);
+            frame.inner.deinit();
+            global.alloc().destroy(frame);
+        }
+
+        export fn ghostty_surface_set_presentation_health(ptr: *Surface, healthy: bool) void {
+            ptr.core_surface.reportPresentationHealth(if (healthy) .healthy else .unhealthy);
+        }
+    };
+
     // Darwin-only C APIs.
     const Darwin = struct {
         export fn ghostty_surface_set_display_id(ptr: *Surface, display_id: u32) void {
