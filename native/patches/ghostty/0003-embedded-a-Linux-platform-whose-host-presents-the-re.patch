 };
 
 /// Inspector is the state required for the terminal inspector. A terminal
@@ -1698,6 +1742,9 @@ pub const CAPI = struct {
         if (builtin.target.os.tag.isDarwin()) {
             _ = Darwin;
         }
+        if (builtin.target.os.tag == .linux) {
