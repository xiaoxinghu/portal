+//! The textures finished frames are exported from.
+//!
+//! A frame is copied out of its render target into one of these plain
+//! `GL_RGBA8` textures and that texture is exported as a dma-buf (Mesa
+//! cannot export the `GL_SRGB8_ALPHA8` texture we render to, and the blit
+//! copies the already-sRGB-encoded values verbatim).
+//!
+//! Whoever presents the frame reads the texture long after `present`
+//! returns, so a texture is held from the export until its frame is let
+//! go of (`Dmabuf.deinit`) and nothing is copied into it meanwhile. That
+//! is why these are apart from the swap chain: the swap chain takes its
+//! next target as soon as a frame is queued, and waits for every target
+//! when it is torn down, while a presenter keeps the frame on screen
+//! until another replaces it.
+//!
+//! Every GL call here is made on the render thread. Letting go of a frame
+//! only clears a flag, from any thread, and may come after the renderer
+//! is gone: the pool is freed when the renderer and the last frame have
+//! both let go of it.
+const ExportPool = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const gl = @import("opengl");
+const egl = gl.egl;
+const global = @import("../../global.zig");
+const xev = global.xev;
+const Dmabuf = @import("../Dmabuf.zig");
+
+const log = std.log.scoped(.opengl);
+
+/// The most textures we keep. A presenter holds the frame on screen and
+/// the one it committed after it, the latest-frame queue holds one and
+/// one is being copied into: four. The rest is room for a release that
+/// is still on its way. Past this a frame is dropped.
+pub const max_textures = 6;
+
+/// Texture ids, unique in the process and never used again.
+var next_id: std.atomic.Value(u64) = .init(1);
+
+alloc: Allocator,
+
+/// One for the renderer and one for each frame out.
+refs: std.atomic.Value(usize) = .init(1),
+
+textures: [max_textures]Texture = @splat(.{}),
+
+/// Set when a frame was dropped because every texture was held. The
+/// release that finds it set wakes the render thread, which draws the
+/// frame again.
+starved: std.atomic.Value(bool) = .init(false),
+
+/// The render thread's wakeup, until that thread exits.
+waker_mutex: std.Io.Mutex = .init,
+waker: ?*xev.Async,
+
+const Texture = struct {
+    /// True from the export until the frame is let go of. Set on the
+    /// render thread, cleared from any thread.
+    held: std.atomic.Value(bool) = .init(false),
+
+    /// The GL objects, null until first used and after
+    /// `releaseGpuResources`. The storage of a texture that is held
+    /// outlives them: the dma-buf keeps it. Render thread only.
+    gpu: ?Gpu = null,
+
+    const Gpu = struct {
+        id: u64,
+        texture: gl.Texture,
+        framebuffer: gl.Framebuffer,
+        width: usize,
+        height: usize,
+
+        fn init(width: usize, height: usize) !Gpu {
+            const texture = try gl.Texture.create();
+            errdefer texture.destroy();
+            {
+                const bound_tex = try texture.bind(.@"2d");
+                defer bound_tex.unbind();
+                try bound_tex.parameter(.min_filter, .nearest);
+                try bound_tex.parameter(.mag_filter, .nearest);
+                try bound_tex.parameter(.wrap_s, .clamp_to_edge);
+                try bound_tex.parameter(.wrap_t, .clamp_to_edge);
+                try bound_tex.image2D(
+                    0,
+                    .rgba,
+                    @intCast(width),
+                    @intCast(height),
+                    .rgba,
+                    .unsigned_byte,
+                    null,
+                );
+                try bound_tex.parameter(.base_level, 0);
+                try bound_tex.parameter(.max_level, 0);
+            }
+
+            const fbo = try gl.Framebuffer.create();
+            errdefer fbo.destroy();
+            {
+                const bound_fbo = try fbo.bind(.framebuffer);
+                defer bound_fbo.unbind();
+                try bound_fbo.texture2D(.color0, .@"2d", texture, 0);
+                switch (bound_fbo.checkStatus()) {
+                    .complete => {},
+                    else => |status| {
+                        log.warn("export framebuffer incomplete status={}", .{status});
+                        return error.FramebufferIncomplete;
+                    },
+                }
+            }
+
+            return .{
+                .id = next_id.fetchAdd(1, .monotonic),
+                .texture = texture,
+                .framebuffer = fbo,
+                .width = width,
+                .height = height,
+            };
+        }
+
+        fn deinit(self: Gpu) void {
+            self.framebuffer.destroy();
+            self.texture.destroy();
+        }
+    };
+};
+
+/// Let go of a frame's texture: `Dmabuf.Planes.Hold.release`. Any thread.
+fn release(ptr: *anyopaque, index: usize) void {
+    const self: *ExportPool = @ptrCast(@alignCast(ptr));
+    self.textures[index].held.store(false, .seq_cst);
+
+    // A frame was dropped for want of this texture: have it drawn.
+    if (self.starved.swap(false, .seq_cst)) {
+        self.waker_mutex.lockUncancelable(global.io());
+        defer self.waker_mutex.unlock(global.io());
+        if (self.waker) |waker| waker.notify() catch |err| {
+            log.warn("failed to wake the renderer for a dropped frame err={}", .{err});
+        };
+    }
+
+    self.unref();
+}
+
+/// `waker` is the render thread's wakeup. It is used until `detach`.
+pub fn create(alloc: Allocator, waker: *xev.Async) !*ExportPool {
+    const self = try alloc.create(ExportPool);
+    self.* = .{ .alloc = alloc, .waker = waker };
+    return self;
+}
+
+/// The render thread is exiting: its wakeup is not used after this
+/// returns. Render thread.
+pub fn detach(self: *ExportPool) void {
+    self.releaseGpuResources();
+    self.waker_mutex.lockUncancelable(global.io());
+    defer self.waker_mutex.unlock(global.io());
+    self.waker = null;
+}
+
+/// The renderer lets go of the pool. Frames still out keep it until
+/// they are let go of too. Any thread, after `detach`.
+pub fn deinit(self: *ExportPool) void {
+    self.unref();
+}
+
+fn unref(self: *ExportPool) void {
+    if (self.refs.fetchSub(1, .seq_cst) == 1) self.alloc.destroy(self);
+}
+
+/// Delete every GL object, those of held textures too: their storage
+/// lives on in the dma-buf. Render thread, with its context current.
+pub fn releaseGpuResources(self: *ExportPool) void {
+    for (&self.textures) |*t| {
+        if (t.gpu) |gpu| gpu.deinit();
+        t.gpu = null;
+    }
+}
+
+/// A texture of this size that no frame holds, or null if every texture
+/// is held. Every texture of another size that no frame holds is deleted
+/// on the way, so a resize leaves none behind but those still shown.
+fn acquire(self: *ExportPool, width: usize, height: usize) !?usize {
+    var found: ?usize = null;
+    var empty: ?usize = null;
+    for (&self.textures, 0..) |*t, i| {
+        if (t.held.load(.seq_cst)) continue;
+        if (t.gpu) |gpu| {
+            if (gpu.width == width and gpu.height == height) {
+                if (found == null) found = i;
+                continue;
+            }
+            gpu.deinit();
+            t.gpu = null;
+        }
+        if (empty == null) empty = i;
+    }
+    if (found) |i| return i;
+
+    const i = empty orelse return null;
+    self.textures[i].gpu = try .init(width, height);
+    return i;
+}
+
+/// Copy `source`, a framebuffer of this size, into a texture no frame
+/// holds and export that texture as a dma-buf, held until the result's
+/// `deinit`. Render thread.
+pub fn exportDmabuf(
+    self: *ExportPool,
+    source: gl.Framebuffer,
+    width: usize,
+    height: usize,
+    display: *egl.Display,
+    context: *egl.Context,
+) !Dmabuf {
+    const index = try self.acquire(width, height) orelse index: {
+        // A release between the search and this store would wake
+        // nobody, so look once more after it.
+        self.starved.store(true, .seq_cst);
+        const index = try self.acquire(width, height) orelse
+            return error.ExportTexturesBusy;
+        self.starved.store(false, .seq_cst);
+        break :index index;
+    };
+    const texture = &self.textures[index];
+    const gpu = texture.gpu.?;
+
+    // We disable GL_FRAMEBUFFER_SRGB while doing this blit, otherwise
+    // the values may be linearized as they're copied, but even though
+    // the draw framebuffer has a linear internal format, the values in
+    // it should be sRGB, not linear!
+    try gl.disable(gl.c.GL_FRAMEBUFFER_SRGB);
+    defer gl.enable(gl.c.GL_FRAMEBUFFER_SRGB) catch |err| {
+        log.err("Error re-enabling GL_FRAMEBUFFER_SRGB, err={}", .{err});
+    };
+
+    const read_bind = try source.bind(.read);
+    defer read_bind.unbind();
+
+    const draw_bind = try gpu.framebuffer.bind(.draw);
+    defer draw_bind.unbind();
+
+    try gl.blitFramebuffer(
+        0,
+        0,
+        @intCast(width),
+        @intCast(height),
+        0,
+        0,
+        @intCast(width),
+        @intCast(height),
+        .{ .color_buffer_bit = true },
+        .nearest,
+    );
+
+    const image: *egl.Image = try .create(
+        display,
+        context,
+        .{ .texture_2d = gpu.texture.id },
+        &.{},
+    );
+    defer image.destroy(display) catch {};
+
+    const query = try image.exportDmabufQuery(display);
+
+    if (query.num_planes < 1 or query.num_planes > Dmabuf.max_planes) {
+        log.err("DMABUF has too many planes={}", .{query.num_planes});
+        return error.DmabufTooManyPlanes;
+    }
+
+    var planes: Dmabuf.Planes = .{ .count = @intCast(query.num_planes) };
+    try image.exportDmabuf(
+        display,
+        &planes.fds,
+        &planes.strides,
+        &planes.offsets,
+    );
+    try planes.validate();
+
+    // From here the frame holds the texture.
+    texture.held.store(true, .seq_cst);
+    _ = self.refs.fetchAdd(1, .seq_cst);
+    planes.hold = .{
+        .ptr = self,
+        .index = index,
+        .release = &release,
+    };
+
+    return .{
+        .width = @intCast(width),
+        .height = @intCast(height),
+        // bitCast instead of intCast since the numerical value of fourccs
+        // is rather meaningless, and we only care about the bit pattern
+        .fourcc = @bitCast(query.fourcc),
+        .modifier = query.modifier,
+        .premultiplied = true,
+        .texture = gpu.id,
+        .planes = planes,
+    };
+}
