diff --git a/include/ghostty.h b/include/ghostty.h
index 9a12b9cad..f1878e487 100644
--- a/include/ghostty.h
+++ b/include/ghostty.h
@@ -70,6 +70,7 @@ typedef enum {
   GHOSTTY_PLATFORM_INVALID,
   GHOSTTY_PLATFORM_MACOS,
   GHOSTTY_PLATFORM_IOS,
+  GHOSTTY_PLATFORM_LINUX,
 } ghostty_platform_e;
 
 typedef enum {
@@ -494,9 +495,40 @@ typedef struct {
   void* uiview;
 } ghostty_platform_ios_s;
 
+// Linux: the host presents the frames itself. The renderer draws on a
+// thread of its own and queues each finished frame, the latest replacing
+// the one before; the host takes it with ghostty_surface_take_frame.
+//
+// frame_ready_cb, if not NULL, is called with frame_ready_userdata each
+// time a frame is queued, and no GHOSTTY_ACTION_RENDER is sent for this
+// surface at all: a host that takes frames on a thread of its own does
+// not wait for ghostty_app_tick. It is called on the render thread while
+// the renderer is locked, so it must return at once: wake whoever
+// presents, and call nothing of this library but
+// ghostty_surface_take_frame. ghostty_surface_set_presentation_health,
+// ghostty_surface_free and anything else that waits for the render thread
+// would wait for ever. It is fixed for the surface's life and is not
+// called once ghostty_surface_free has returned, which is when the
+// userdata can be freed.
+//
+// With frame_ready_cb NULL, GHOSTTY_ACTION_RENDER reaches the action
+// callback for each frame, from ghostty_app_tick.
+typedef void (*ghostty_frame_ready_cb)(void*);
+
+typedef struct {
+  // The EGLDisplay to render with, or NULL for Mesa's surfaceless
+  // display. Only the first surface's counts: the app renders every
+  // surface with the display that one gave, and ignores a later one's.
+  void* egl_display;
+  ghostty_frame_ready_cb frame_ready_cb;
+  void* frame_ready_userdata;
+} ghostty_platform_linux_s;
+
+// The member is linux_ because `linux` is a predefined macro in GNU C.
 typedef union {
   ghostty_platform_macos_s macos;
   ghostty_platform_ios_s ios;
+  ghostty_platform_linux_s linux_;
 } ghostty_platform_u;
 
 typedef enum {
@@ -1185,6 +1217,8 @@ GHOSTTY_API void ghostty_surface_update_config(ghostty_surface_t, ghostty_config
 GHOSTTY_API bool ghostty_surface_needs_confirm_quit(ghostty_surface_t);
 GHOSTTY_API bool ghostty_surface_process_exited(ghostty_surface_t);
 GHOSTTY_API void ghostty_surface_refresh(ghostty_surface_t);
+// On Linux this does not draw on the calling thread: it asks the render
+// thread for a frame, drawn even if nothing changed, and returns at once.
 GHOSTTY_API void ghostty_surface_draw(ghostty_surface_t);
 GHOSTTY_API void ghostty_surface_set_content_scale(ghostty_surface_t, double, double);
 GHOSTTY_API void ghostty_surface_set_focus(ghostty_surface_t, bool);
@@ -1241,6 +1275,64 @@ GHOSTTY_API bool ghostty_surface_read_text(ghostty_surface_t,
                                               ghostty_text_s*);
 GHOSTTY_API void ghostty_surface_free_text(ghostty_surface_t, ghostty_text_s*);
 
+#ifdef __linux__
+// A finished frame, for a host that presents frames itself (see
+// ghostty_platform_linux_s). Either a DMABUF or, once the host has
+// reported that it cannot present those, RGBA8 pixels in memory, width * 4
+// bytes a row. The first row is the bottom one when bottom_up is set.
+//
+// A DMABUF frame is one of a few textures, named by `texture`: an id that
+// is not 0, is the same for every frame exported from that texture and is
+// never used for another one, in this surface or any other. A host can
+// keep the buffer it imported for an id and use it for later frames with
+// that id. fds are new for every frame and belong to the frame. The
+// textures are made anew, with new ids, when the surface changes size or
+// is shown again after ghostty_surface_set_occlusion hid it: a buffer kept
+// for an old id, once no frame is shown from it, is of no more use. A
+// memory frame has texture 0. A frame stays valid until it is freed,
+// whatever happens to its surface meanwhile.
+typedef enum {
+  GHOSTTY_FRAME_DMABUF = 1,
+  GHOSTTY_FRAME_MEMORY = 2,
+} ghostty_frame_kind_e;
+
+typedef struct {
+  ghostty_frame_kind_e kind;
+  uint32_t width;
+  uint32_t height;
+  bool bottom_up;
+  bool premultiplied;
+  uint64_t texture;
+  uint32_t fourcc;
+  uint64_t modifier;
+  uint32_t plane_count;
+  int fds[4];
+  uint32_t offsets[4];
+  uint32_t strides[4];
+  const uint8_t* pixels;
+} ghostty_frame_s;
+
+// Take the latest finished frame, or NULL if there is none since the last
+// one taken. The caller owns it until ghostty_frame_free. From any thread,
+// but not while or after the surface is freed.
+GHOSTTY_API ghostty_frame_s* ghostty_surface_take_frame(ghostty_surface_t);
+
+// Free a frame: its fds are closed, or its pixels freed, and the renderer
+// may draw into its texture again. Until then it does not, so free a
+// DMABUF frame when nothing shows it any more and not before: for a
+// Wayland host, when the compositor releases the wl_buffer the frame was
+// committed with, or when that buffer is destroyed. A frame that was not
+// shown can be freed at once. The renderer keeps a few textures and drops
+// frames while the host holds them all, drawing again once one is freed.
+// From any thread, and also after the frame's surface is freed.
+GHOSTTY_API void ghostty_frame_free(ghostty_frame_s*);
+
+// false when the host cannot present DMABUFs: frames drawn from then on
+// come in memory. No frame is drawn for this alone, so follow it with
+// ghostty_surface_draw to have one. Not from the frame-ready callback.
+GHOSTTY_API void ghostty_surface_set_presentation_health(ghostty_surface_t, bool);
+#endif
+
 #ifdef __APPLE__
 GHOSTTY_API void ghostty_surface_set_display_id(ghostty_surface_t, uint32_t);
 GHOSTTY_API void* ghostty_surface_quicklook_font(ghostty_surface_t);
diff --git a/src/Surface.zig b/src/Surface.zig
index 369bb2399..7a26e63a4 100644
--- a/src/Surface.zig
+++ b/src/Surface.zig
@@ -923,6 +923,15 @@ fn queueIo(
 /// is in the middle of animation (such as a resize, etc.) or when
 /// the render timer is managed manually by the apprt.
 pub fn draw(self: *Surface) !void {
+    // OpenGL draws on the render thread only: its context is current
+    // there and its functions are loaded per thread. Ask that thread
+    // for a frame instead, drawn even if nothing changed.
+    if (comptime Renderer.API == rendererpkg.OpenGL) {
+        self.renderer.force_redraw.store(true, .seq_cst);
+        try self.queueRender();
+        return;
+    }
+
     // Renderers are required to support `drawFrame` being called from
     // the main thread, so that they can update contents during resize.
     try self.renderer.drawFrame(true);
