{
	"compilerOptions": {
		"target": "ES2023",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"erasableSyntaxOnly": true
	},
	"include": ["./**/*.ts"]
}
